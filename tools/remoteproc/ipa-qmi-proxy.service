[Unit]
Description=AP-side IPA-QMI proxy for external SDX55 modem
DefaultDependencies=no
After=local-fs.target
Before=basic.target
Conflicts=shutdown.target reboot.target halt.target kexec.target poweroff.target
Before=shutdown.target reboot.target halt.target kexec.target poweroff.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ipa_qmi_proxy -V
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes

[Install]
WantedBy=sysinit.target
