[Unit]
Description=Write MCFG ignore_data_cleanup NV item via EFS MHI channel before modem crash
DefaultDependencies=no
After=local-fs.target
Before=basic.target
Conflicts=shutdown.target reboot.target halt.target kexec.target poweroff.target
Before=shutdown.target reboot.target halt.target kexec.target poweroff.target

[Service]
Type=simple
ExecStart=/usr/local/bin/diag-efs-write-runner.sh
Restart=on-failure
RestartSec=1
TimeoutStartSec=45
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal
Environment=XIAOMI_DIAG_EFS_WRITE=1

[Install]
WantedBy=sysinit.target
