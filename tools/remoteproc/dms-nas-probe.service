[Unit]
Description=Minimal DMS/NAS QMI client probe for SDX55 protocol stack init
DefaultDependencies=no
After=local-fs.target
Before=basic.target
Conflicts=shutdown.target reboot.target halt.target kexec.target poweroff.target
Before=shutdown.target reboot.target halt.target kexec.target poweroff.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dms_nas_probe
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
