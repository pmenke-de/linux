[Unit]
Description=Native SSCTL (QMI svc 43) client probe for SDX55
DefaultDependencies=no
After=local-fs.target
Before=basic.target
Conflicts=shutdown.target reboot.target halt.target kexec.target poweroff.target
Before=shutdown.target reboot.target halt.target kexec.target poweroff.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sysmon_probe_native
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
