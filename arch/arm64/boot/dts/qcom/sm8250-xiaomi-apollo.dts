		"Digital Mic2", "MIC BIAS1",
		"Digital Mic3", "MIC BIAS1",
		"Digital Mic4", "MIC BIAS4",
		"Digital Mic5", "MIC BIAS4",
		"TX SWR_ADC0", "ADC1_OUTPUT",
		"TX SWR_ADC1", "ADC2_OUTPUT",
		"TX SWR_ADC2", "ADC3_OUTPUT",
		"TX SWR_ADC3", "ADC4_OUTPUT",
		"DMIC1 Pin", "MIC BIAS3",
		"DMIC2 Pin", "MIC BIAS3",
